#!/usr/bin/env bash
# Avisa o claude-hud sobre o estado de uma sessão do Claude Code.
#
# Uso, como hook: claude-hud-hook <estado>
#   estado: start | thinking | working | waiting | done | end
#
# Lê da entrada padrão o JSON que o Claude Code entrega aos hooks. Nunca falha
# nem trava: sem ter para onde mandar, sai em silêncio.
#
# Com CLAUDE_HUD_URL definida, o evento vai para o recadeiro, que o entrega à
# placa pelo Wi-Fi. Sem ela, vai direto para a serial USB da placa.
#
# Variáveis, do ambiente ou de ~/.config/claude-hud/env:
#   CLAUDE_HUD_SOURCE  origem mostrada no visor: pc (padrão), cloud ou phone
#   CLAUDE_HUD_URL     endereço do recadeiro, como https://hud.example.com
#   CLAUDE_HUD_TOKEN   segredo do recadeiro
#   CLAUDE_HUD_DEVICE  porta serial da placa; por padrão, a primeira Espressif

state=${1:-}
[ -n "$state" ] || exit 0

# Os hooks rodam em paralelo; a hora tirada logo aqui é o que permite ao
# recadeiro pôr os eventos em ordem.
stamp=$(date +%s%3N)

config=${XDG_CONFIG_HOME:-$HOME/.config}/claude-hud/env
# shellcheck disable=SC1090
[ -r "$config" ] && . "$config"

source_name=${CLAUDE_HUD_SOURCE:-pc}
session=-

if [ ! -t 0 ] && command -v jq >/dev/null 2>&1; then
  payload=$(cat)
  session=$(jq -r '(.session_id // "-")[0:8]' <<<"$payload" 2>/dev/null)
  # Uma pergunta ao usuário é uma ferramenta, mas quem trabalha agora é a pessoa.
  if [ "$state" = working ]; then
    tool=$(jq -r '.tool_name // ""' <<<"$payload" 2>/dev/null)
    case $tool in
      AskUserQuestion | ExitPlanMode) state=waiting ;;
    esac
  fi
fi

event="$source_name $state ${session:--}"

if [ -n "${CLAUDE_HUD_URL:-}" ]; then
  curl --silent --max-time 4 --output /dev/null \
    --header "Authorization: Bearer ${CLAUDE_HUD_TOKEN:-}" \
    --data "$stamp $event" "${CLAUDE_HUD_URL%/}/events" 2>/dev/null
  exit 0
fi

device=${CLAUDE_HUD_DEVICE:-}
if [ -z "$device" ]; then
  for candidate in /dev/serial/by-id/usb-Espressif_USB_JTAG_serial_debug_unit_*; do
    [ -e "$candidate" ] && device=$candidate && break
  done
fi
[ -n "$device" ] && [ -w "$device" ] || exit 0

# Sem eco: com ele, o que a placa escreve voltaria para ela como comando.
stty -F "$device" 115200 raw -echo -hupcl 2>/dev/null

timeout 1 bash -c 'printf "%s\n" "$1" >"$2"' _ "$event" "$device" 2>/dev/null
exit 0
