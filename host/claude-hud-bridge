#!/usr/bin/env python3
"""Leva para a placa os eventos de uma máquina remota.

Uso: claude-hud-bridge <host-ssh>

Na máquina remota, o claude-hud-hook grava cada evento em um arquivo. Este
programa acompanha o arquivo por ssh e repassa as linhas para a serial USB da
placa. Se a conexão cai, encerra na placa as sessões daquela máquina e tenta de
novo.

Variáveis:
  CLAUDE_HUD_DEVICE      porta serial da placa; por padrão, a primeira Espressif
  CLAUDE_HUD_REMOTE_LOG  arquivo de eventos na máquina remota, relativo ao home
"""

import glob
import os
import subprocess
import sys
import termios
import time

DEVICE_GLOB = "/dev/serial/by-id/usb-Espressif_USB_JTAG_serial_debug_unit_*"
REMOTE_LOG = os.environ.get("CLAUDE_HUD_REMOTE_LOG", ".local/state/claude-hud/events")

# Mesmo prazo em que a placa dá uma sessão como morta.
STALE_SECONDS = 30 * 60
# A comemoração só vale para quem acabou de terminar.
DONE_SECONDS = 20
RETRY_SECONDS = 5

STATES = {"start", "idle", "thinking", "working", "waiting", "done", "end"}
SOURCES = {"pc", "cloud", "phone"}


class Translator:
    """Decide o que fazer com cada linha do arquivo de eventos.

    O arquivo é relido do começo quando a conexão volta e quando ele é
    encurtado, então linhas antigas e repetidas são esperadas.
    """

    def __init__(self):
        self.last_stamp = 0
        self.open_sessions = set()

    def translate(self, line, now):
        """Devolve o evento a mandar para a placa, ou None para descartar."""
        parts = line.split()
        if len(parts) != 4 or not parts[0].isdigit():
            return None
        stamp, source, state, session = int(parts[0]), parts[1], parts[2], parts[3]
        if source not in SOURCES or state not in STATES:
            return None
        if stamp < self.last_stamp:
            return None
        self.last_stamp = stamp

        age = now - stamp
        if age > STALE_SECONDS:
            return None
        if state == "done" and age > DONE_SECONDS:
            state = "idle"

        key = (source, session)
        if state == "end":
            self.open_sessions.discard(key)
        else:
            self.open_sessions.add(key)
        return f"{source} {state} {session}"

    def close_all(self):
        """Eventos que encerram na placa tudo o que esta ponte abriu."""
        events = [f"{source} end {session}" for source, session in sorted(self.open_sessions)]
        self.open_sessions.clear()
        return events


def find_device():
    explicit = os.environ.get("CLAUDE_HUD_DEVICE")
    if explicit:
        return explicit
    candidates = sorted(glob.glob(DEVICE_GLOB))
    return candidates[0] if candidates else None


def send(event):
    """Escreve um evento na placa. Sem placa, o evento se perde."""
    device = find_device()
    if not device:
        return
    try:
        fd = os.open(device, os.O_WRONLY | os.O_NOCTTY | os.O_NONBLOCK)
    except OSError:
        return
    try:
        # Sem eco: com ele, o que a placa escreve voltaria para ela como comando.
        attrs = termios.tcgetattr(fd)
        attrs[0] = 0
        attrs[1] = 0
        attrs[2] = termios.CS8 | termios.CREAD | termios.CLOCAL
        attrs[3] = 0
        termios.tcsetattr(fd, termios.TCSANOW, attrs)
        os.write(fd, (event + "\n").encode())
    except (OSError, termios.error):
        pass
    finally:
        os.close(fd)


def follow(host):
    """Acompanha o arquivo remoto até a conexão cair."""
    directory = os.path.dirname(REMOTE_LOG) or "."
    remote = f"mkdir -p {directory} && touch {REMOTE_LOG} && exec tail -n 100 -F {REMOTE_LOG}"
    command = [
        "ssh",
        "-o", "BatchMode=yes",
        "-o", "ConnectTimeout=10",
        "-o", "ServerAliveInterval=15",
        "-o", "ServerAliveCountMax=3",
        host,
        remote,
    ]
    translator = Translator()
    process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    try:
        for line in process.stdout:
            event = translator.translate(line, time.time())
            if event:
                send(event)
    finally:
        process.kill()
        process.wait()
        for event in translator.close_all():
            send(event)


def main():
    if len(sys.argv) != 2:
        sys.exit(__doc__.strip())
    while True:
        follow(sys.argv[1])
        time.sleep(RETRY_SECONDS)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
