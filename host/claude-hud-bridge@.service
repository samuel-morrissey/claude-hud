# Unidade de usuário do systemd. O nome depois do @ é o host ssh:
#   systemctl --user enable --now claude-hud-bridge@vps
[Unit]
Description=claude-hud: eventos do Claude Code em %i
After=network-online.target

[Service]
ExecStart=%h/Work/samuel-morrissey/claude-hud/host/claude-hud-bridge %i
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
